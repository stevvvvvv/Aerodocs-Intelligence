# --- Embeddings -----------------------------------------------------------
# local   : multilingual-e5-small (questions FR sur docs EN), téléchargé au build Docker
# hashing : sans modèle, pour tests / démo hors-ligne (mettre INSTALL_ML=false)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
INSTALL_ML=true

# --- Génération -----------------------------------------------------------
# extractive (aucun LLM, défaut) | anthropic | openai | ollama
LLM_PROVIDER=extractive
LLM_MODEL=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai          (ou toute API compatible : Mistral, vLLM...)
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=ollama          (docker compose --profile ollama up ; puis : docker compose exec ollama ollama pull mistral)
# LLM_MODEL=mistral
OLLAMA_URL=http://ollama:11434

# --- Garde-fous (laisser vide = valeurs par défaut du fournisseur d'embeddings) ---
TOP_K=6
MIN_SIMILARITY=
MIN_CITATION_COVERAGE=0.6
