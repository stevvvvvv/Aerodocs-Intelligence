# Image tout-en-un pour la démo publique (Hugging Face Space, SDK Docker) :
# PostgreSQL + pgvector, API FastAPI et interface React dans un seul conteneur, port 7860.
# En local, utilisez plutôt docker-compose.yml (services séparés).

FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM python:3.12-slim

# PostgreSQL 16 + pgvector depuis le dépôt officiel PGDG
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-16 postgresql-16-pgvector \
 && rm -rf /var/lib/apt/lists/*

# Hugging Face exécute le conteneur avec l'UID 1000
RUN useradd -m -u 1000 user
ENV HOME=/home/user PATH=/usr/lib/postgresql/16/bin:$PATH \
    PYTHONUNBUFFERED=1 HF_HOME=/home/user/models
WORKDIR /home/user/app

COPY --chown=user backend/requirements.txt backend/requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ml.txt

USER user
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('intfloat/multilingual-e5-small')"
ENV HF_HUB_OFFLINE=1

COPY --chown=user backend/ ./
COPY --chown=user data/demo/ /home/user/demo/
COPY --chown=user --from=web /web/dist /home/user/web
COPY --chown=user deploy/start-space.sh /home/user/start.sh

# Démo publique : lecture seule, sans LLM par défaut (réponses extractives, instantanées).
# Pour une vraie génération : ajouter LLM_PROVIDER, LLM_MODEL et ANTHROPIC_API_KEY dans les secrets du Space.
ENV DATABASE_URL=postgresql+psycopg://user@localhost:5432/aerodocs \
    UPLOAD_DIR=/home/user/storage \
    STATIC_DIR=/home/user/web \
    READ_ONLY=true \
    EMBEDDING_PROVIDER=local \
    LLM_PROVIDER=extractive

EXPOSE 7860
CMD ["bash", "/home/user/start.sh"]
